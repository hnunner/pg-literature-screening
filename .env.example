# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real key here.

# --- Anthropic backend (default) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI-compatible backend (--backend openai) ---
# Works with OpenAI, OpenRouter, vLLM, Ollama, LM Studio, university gateways.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Model ---
# One knob for either backend; --model on the command line still wins.
# Compare cost for your corpus with:  python full-screen.py --list-models
#
#   claude-opus-5      most capable, ~5x the cost of Haiku
#   claude-sonnet-5    near-Opus on most work; sensible default
#   claude-haiku-4-5   cheapest; verify quality on a --limit 5 run first
SCREEN_MODEL=claude-sonnet-5
